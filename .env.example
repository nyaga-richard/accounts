# Local development and Docker Compose settings. Never commit a real .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Used by local npm run dev; Compose constructs DATABASE_URL from POSTGRES_PASSWORD.
DATABASE_URL=postgres://ledgerway:replace-with-a-long-random-password@127.0.0.1:5432/ledgerway
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Local defaults. For a production Cloudflare deployment, install script writes the public HTTPS origin.
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
# Only needed when starting Compose with --profile tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
